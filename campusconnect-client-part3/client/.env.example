# Base URL of the Express + Socket.IO server (no trailing slash, no /api)
VITE_API_URL=http://localhost:5000

# true  = use the in-browser mock API (works without the backend)
# false = talk to the real server at VITE_API_URL
# Must be false for any deployed build.
VITE_USE_MOCKS=true

# Set to false to hide the Chat Memory (AI) button, e.g. if the AI endpoint isn't deployed.
VITE_FEATURE_CHAT_MEMORY=true
